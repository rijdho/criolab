        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#2C3E50;fontFamily=Helvetica;" value="Cuatro trabajos, dos hilos: un mapa crítico" vertex="1">
